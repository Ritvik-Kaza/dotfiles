* {
    bg:         rgba(14, 12, 22, 0.90);
    bg-alt:     rgba(22, 19, 32, 0.85);
    fg:         #e6e3f0;
    fg-dim:     #8b859e;
    accent:     rgba(138, 127, 196, 0.45);
    accent-fg:  #ffffff;
    border:     rgba(255, 255, 255, 0.08);

    background-color:   transparent;
    text-color:          @fg;
}

window {
    location:    center;
    width:       420px;
    border:      1px;
    border-color: @border;
    border-radius: 16px;
    background-color: @bg;
    padding:     10px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 10px;
}

inputbar {
    background-color: @bg-alt;
    border:          1px;
    border-color:    @border;
    border-radius:   12px;
    padding:         10px 14px;
    spacing:         8px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @fg-dim;
}

entry {
    placeholder:       "Search";
    placeholder-color: @fg-dim;
    text-color:        @fg;
}

listview {
    background-color: transparent;
    lines:        8;
    spacing:      4px;
    scrollbar:    false;
    fixed-height: false;
}

element {
    background-color: transparent;
    text-color:       @fg;
    border-radius:    12px;
    padding:          8px 10px;
    spacing:          10px;
    orientation:      horizontal;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element selected.normal {
    background-color: @accent;
    text-color:       @accent-fg;
}

element-icon {
    size:    22px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
}
