{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "󰌾",
    "keybind" : "l"
}
{
    "label" : "suspend",
    "action" : "hyprlock & sleep 1 && systemctl suspend",
    "text" : "󰤄",
    "keybind" : "s"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "󰜉",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "󰐥",
    "keybind" : "p"
}
